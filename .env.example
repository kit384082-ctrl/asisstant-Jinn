# GitHub repository and a fine-grained token with the required read permissions.
# Contents write access is needed only for append_file commands.
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=owner/repository

# Active conversational AI provider: openai, gemini, anthropic, groq, local, or custom.
# Credentials stay in this local file and are never returned by the settings/status API.
# The local Ollama profile is keyless and keeps prompts/model weights on this computer.
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_SMALL_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_SMALL_MODEL=gemini-2.0-flash-lite

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_SMALL_MODEL=claude-3-5-haiku-latest

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_SMALL_MODEL=llama-3.1-8b-instant

# Free local Jinn 1.5B profile. Create it with ./scripts/install-jinn.sh.
# The external qwen2.5:1.5b weights remain in Ollama's store, outside this repository.
# For privacy, the endpoint is restricted to localhost/loopback addresses.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=jinn
OLLAMA_SMALL_MODEL=jinn

# Any HTTPS OpenAI-compatible endpoint can be used as the custom provider.
# Explicit loopback HTTP endpoints are also accepted for local development.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_SMALL_MODEL=

# Optional global economy routing and bounded generation/search controls.
AI_SMALL_MODEL_MODE=false
AI_REQUEST_TIMEOUT=30
AI_TEMPERATURE=0.35
AI_TOP_P=0.9
AI_MAX_TOKENS=1200
AI_FREQUENCY_PENALTY=0
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=5

# Interface: auto, ru, en, de, es, or fr.
# Voice locale must match the downloaded Vosk model used by --voice-only.
UI_LANGUAGE=auto
VOICE_LANGUAGE=ru-RU
# Optional comma-separated override. Leave empty for localized defaults.
WAKE_WORDS=
VOSK_MODEL_PATH=model
TTS_VOICE=ru-RU-SvetlanaNeural

# Local web GUI and personal data (agenda, notes, custom applications).
GUI_HOST=127.0.0.1
GUI_PORT=8765
AGENT_DATA_PATH=.genie/agent.db
